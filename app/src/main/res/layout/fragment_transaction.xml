<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/transaction_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TransactionFragment">

    <LinearLayout
        android:id="@+id/page_title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/pageHeadingBackgroundColor"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/page_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/add_expense"
            android:textColor="?attr/pageHeadingFontColor"
            android:textSize="@dimen/page_header_font_size"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fadeScrollbars="false"
        android:padding="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/page_title_layout"
        app:layout_constraintBottom_toTopOf="@id/expansion_layout">

        <RelativeLayout
            android:id="@+id/relativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:layout_editor_absoluteY="56dp">

            <LinearLayout
                android:id="@+id/dateHeadingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/date"
                    android:textSize="@dimen/label_font_size"
                    android:textColor="?attr/textOnBackground"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".8"
                    android:text="@string/amount"
                    android:textSize="@dimen/label_font_size"
                    android:textColor="?attr/textOnBackground"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearlayoutDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/dateHeadingLayout"
                android:baselineAligned="false"
                android:paddingBottom="5dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/dateLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_weight="1"
                    android:hint="@string/date"
                    android:minWidth="@dimen/custom_med_width"
                    android:tooltipText="@string/toolTipDate"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/transactionDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:clickable="false"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:gravity="start"
                        android:inputType="date"
                        android:longClickable="false"
                        android:textSize="@dimen/normal_font_size"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/entire_input_amount_area"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/currencySymbol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textStyle="bold"
                        android:textSize="@dimen/normal_font_size"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/amountLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:hint="@string/amount"
                        android:minWidth="@dimen/custom_med_width"
                        android:tooltipText="@string/toolTipAmount"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/transactionAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:gravity="start"
                            android:inputType="numberDecimal|numberSigned"
                            android:textSize="@dimen/normal_font_size"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/inputCategoryLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/linearlayoutDate"
                android:layout_gravity="start"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="@string/category"
                android:textSize="@dimen/label_font_size"
                android:textStyle="bold"
                android:textColor="?attr/textOnBackground"
                android:tooltipText="@string/toolTipCategory" />

            <HorizontalScrollView
                android:id="@+id/radioGroupScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/inputCategoryLabel"
                android:fadeScrollbars="false"
                android:scrollbarThumbHorizontal="?attr/colorSecondary">

                <RadioGroup
                    android:id="@+id/categoryRadioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:checkedButton="@+id/radio_category1"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/input_spinner_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/radioGroupScroll"
                android:paddingTop="10dp">

                <TextView
                    android:id="@+id/inputSubcategoryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/subcategory"
                    android:paddingStart="0dp"
                    android:paddingEnd="5dp"
                    android:textSize="@dimen/label_font_size"
                    android:textStyle="bold"
                    android:textColor="?attr/textOnBackground"
                    android:tooltipText="@string/toolTipSubCategory" />

                <RelativeLayout
                    android:id="@+id/inputSpinnerRelativeLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/spinner_background"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/subcategorySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:background="@android:color/transparent"
                        android:gravity="end"
                        android:spinnerMode="dropdown" />

                    <ImageView
                        android:id="@+id/inputImageView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center"
                        android:contentDescription="@string/click_to_select"
                        android:src="@drawable/ic_baseline_arrow_drop_down_24" />
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/where_note_heading_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:layout_below="@id/input_spinner_layout">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/vendor_name"
                    android:textSize="@dimen/label_font_size"
                    android:textStyle="bold"
                    android:textColor="?attr/textOnBackground"
                    android:tooltipText="@string/toolTipWhere" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/note"
                    android:textSize="@dimen/label_font_size"
                    android:textStyle="bold"
                    android:textColor="?attr/textOnBackground"
                    android:tooltipText="@string/toolTipNote" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutWhereNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/where_note_heading_layout"
                android:baselineAligned="false"
                android:paddingBottom="5dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/whereLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="start"
                    android:hint="@string/vendor_name"
                    android:paddingStart="0dp"
                    android:paddingEnd="5dp"
                    android:minWidth="@dimen/custom_med_width"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/where"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:gravity="start"
                        android:inputType="textCapSentences"
                        android:textSize="@dimen/normal_font_size"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/noteLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/note_optional"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:layout_gravity="end"
                    android:minWidth="@dimen/custom_med_width"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/note"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:gravity="start"
                        android:inputType="textCapSentences"
                        android:textSize="@dimen/normal_font_size"/>
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/translatedWhereMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/linearLayoutWhereNote"
                android:layout_gravity="center"
                android:gravity="end"
                android:textSize="@dimen/normal_font_size"
                android:textStyle="italic"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/transaction_paid_by_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/translatedWhereMessage"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <TextView
                    android:id="@+id/inputPaidByLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/paid_by"
                    android:textSize="@dimen/label_font_size"
                    android:textStyle="bold"
                    android:textColor="?attr/textOnBackground"
                    android:tooltipText="@string/toolTipPaidBy" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_weight="1"
                    android:fadeScrollbars="false"
                    android:scrollbarThumbHorizontal="?attr/colorSecondary">

                    <RadioGroup
                        android:id="@+id/paidByRadioGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:checkedButton="@+id/radio_person3"
                        android:gravity="center"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <ImageView
                    android:id="@+id/transaction_expand_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:contentDescription="@string/click_to_expand"
                    android:src="@drawable/ic_baseline_expand_more_24" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/transaction_bought_for_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/transaction_paid_by_layout"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <TextView
                    android:id="@+id/inputBoughtForLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/bought_for"
                    android:textSize="@dimen/label_font_size"
                    android:textStyle="bold"
                    android:textColor="?attr/textOnBackground"
                    android:tooltipText="@string/toolTipBoughtFor" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fadeScrollbars="false"
                    android:scrollbarThumbHorizontal="?attr/colorSecondary">

                    <RadioGroup
                        android:id="@+id/boughtForRadioGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:checkedButton="@+id/radio_person3"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="1dp" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slider_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/transaction_bought_for_layout"
                android:paddingTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/split"
                    android:textSize="@dimen/label_font_size"
                    android:textStyle="bold"
                    android:textColor="?attr/textOnBackground"
                    android:tooltipText="@string/toolTipSplit" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="0.0"
                    android:valueTo="100.0" />
            </LinearLayout>

            <TextView
                android:id="@+id/split_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/slider_layout"
                android:layout_gravity="center"
                android:gravity="center"
                android:textSize="@dimen/normal_font_size"/>

            <View
                android:id="@+id/line1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"
                android:paddingBottom="10dp"
                android:layout_below="@id/split_text" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/insurableSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_below="@id/line1"
                android:textOff="@string/no"
                android:textOn="@string/yes"
                android:text="@string/covered_by_insurance"
                android:textSize="@dimen/label_font_size"
                android:textStyle="bold"
                android:textColor="?attr/textOnBackground"
                android:tooltipText="Will you be making an insurance claim for this expense?"/>

            <LinearLayout
                android:id="@+id/reimbursed_amount0_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/insurableSwitch"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:minWidth="@dimen/custom_med_width"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/reimbursementAmount0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:gravity="start"
                        android:inputType="numberDecimal|numberSigned"
                        android:textSize="@dimen/normal_font_size"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/paidToLabel0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/paid_to"
                    android:textSize="@dimen/label_font_size"
                    android:textStyle="bold"
                    android:textColor="?attr/textOnBackground"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"/>

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:fadeScrollbars="false"
                    android:scrollbarThumbHorizontal="?attr/colorSecondary">

                    <RadioGroup
                        android:id="@+id/paidTo0RadioGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="1dp" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reimbursed_amount1_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/reimbursed_amount0_layout"
                android:visibility="gone"
                android:paddingBottom="10dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:minWidth="@dimen/custom_med_width"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/reimbursementAmount1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:gravity="start"
                        android:inputType="numberDecimal|numberSigned"
                        android:textSize="@dimen/normal_font_size"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/paidToLabel1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/paid_to"
                    android:textSize="@dimen/label_font_size"
                    android:textStyle="bold"
                    android:textColor="?attr/textOnBackground"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"/>

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:fadeScrollbars="false"
                    android:scrollbarThumbHorizontal="?attr/colorSecondary">

                    <RadioGroup
                        android:id="@+id/paidTo1RadioGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="1dp" />
                </HorizontalScrollView>
            </LinearLayout>

            <View
                android:id="@+id/line2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"
                android:paddingBottom="10dp"
                android:layout_below="@id/reimbursed_amount1_layout" />

            <LinearLayout
                android:id="@+id/scheduled_payment_label_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/line2"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <TextView
                    android:id="@+id/scheduled_payment_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_weight="1"
                    android:paddingTop="10dp"
                    android:textSize="@dimen/label_font_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/button_linear_layout_transaction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/scheduled_payment_label_layout"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/button_save_linear_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/button_cancel"
                        android:layout_width="@dimen/button_size"
                        android:layout_height="@dimen/button_size"
                        android:layout_gravity="center"
                        android:layout_margin="15dp"
                        android:contentDescription="@string/cancel"
                        android:tooltipText="@string/cancel"
                        android:elevation="4dp"
                        android:padding="5dp"
                        android:scaleType="fitXY"
                        android:background="?attr/background"
                        android:src="@drawable/ic_baseline_cancel_24"
                        android:stateListAnimator="@animator/anim"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/button_save"
                        android:layout_width="@dimen/button_size"
                        android:layout_height="@dimen/button_size"
                        android:layout_gravity="center"
                        android:layout_margin="15dp"
                        android:contentDescription="@string/save"
                        android:tooltipText="@string/save"
                        android:elevation="4dp"
                        android:padding="5dp"
                        android:scaleType="fitXY"
                        android:background="?attr/background"
                        android:src="@drawable/ic_baseline_save_24"
                        android:stateListAnimator="@animator/anim"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/button_load_transaction_from_bank_notification"
                    android:layout_width="@dimen/button_size"
                    android:layout_height="@dimen/button_size"
                    android:layout_gravity="center"
                    android:layout_margin="15dp"
                    android:contentDescription="@string/load_from_bank_notification"
                    android:tooltipText="@string/load_from_bank_notification"
                    android:elevation="4dp"
                    android:padding="5dp"
                    android:scaleType="fitXY"
                    android:background="?attr/background"
                    android:src="@drawable/ic_baseline_notifications_24"
                    android:stateListAnimator="@animator/anim"/>
                <LinearLayout
                    android:id="@+id/button_view_linear_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:visibility="gone"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/button_edit"
                        android:layout_width="@dimen/button_size"
                        android:layout_height="@dimen/button_size"
                        android:layout_gravity="center"
                        android:layout_margin="15dp"
                        android:contentDescription="@string/edit_transaction"
                        android:tooltipText="@string/edit_transaction"
                        android:elevation="4dp"
                        android:padding="5dp"
                        android:scaleType="fitXY"
                        android:background="?attr/background"
                        android:src="@drawable/ic_baseline_edit_24"
                        android:stateListAnimator="@animator/anim"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/button_credit"
                        android:layout_width="@dimen/button_size"
                        android:layout_height="@dimen/button_size"
                        android:layout_gravity="center"
                        android:layout_margin="15dp"
                        android:contentDescription="@string/credit_transaction"
                        android:tooltipText="@string/credit_transaction"
                        android:elevation="4dp"
                        android:padding="5dp"
                        android:scaleType="fitXY"
                        android:background="?attr/background"
                        android:src="@drawable/ic_baseline_backspace_24"
                        android:stateListAnimator="@animator/anim"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/button_delete"
                        android:layout_width="@dimen/button_size"
                        android:layout_height="@dimen/button_size"
                        android:layout_gravity="center"
                        android:layout_margin="15dp"
                        android:contentDescription="@string/delete_transaction"
                        android:tooltipText="@string/delete_transaction"
                        android:elevation="4dp"
                        android:padding="5dp"
                        android:scaleType="fitXY"
                        android:background="?attr/background"
                        android:src="@drawable/ic_baseline_delete_24"
                        android:stateListAnimator="@animator/anim"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/transaction_id_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/button_linear_layout_transaction"
                android:paddingBottom="10dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/category_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textSize="@dimen/label_font_size"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/transaction_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textSize="@dimen/label_font_size"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/transaction_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textSize="@dimen/label_font_size"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="rtKey:"/>
                    <TextView
                        android:id="@+id/rt_key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/label_font_size"
                        android:visibility="gone" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" crKey:"/>
                    <TextView
                        android:id="@+id/credit_key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/label_font_size"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

        </RelativeLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/expansion_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:background="?attr/menuColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <ImageView
            android:id="@+id/button_prev_transaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:scaleType="center"
            android:src="@drawable/ic_baseline_keyboard_arrow_left_24"
            android:contentDescription="@string/toolTipPrevious"
            android:tooltipText="@string/toolTipPrevious" />
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <ImageView
            android:id="@+id/button_next_transaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:scaleType="center"
            android:src="@drawable/ic_baseline_keyboard_arrow_right_24"
            android:contentDescription="@string/go_to_next_transaction"
            android:tooltipText="@string/toolTipNext" />
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>